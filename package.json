{
  "name": "n8n-nodes-mews",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Mews property management system, providing 10 resources and 60+ operations for hospitality workflow automation including reservations, guests, billing, and housekeeping.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-mews.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-mews#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-mews/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "mews",
    "hospitality",
    "hotel",
    "pms",
    "property-management",
    "reservations",
    "booking",
    "housekeeping",
    "automation"
  ],
  "main": "dist/nodes/Mews/Mews.node.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MewsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Mews/Mews.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy:icons",
    "copy:icons": "copyfiles -u 1 \"nodes/**/*.svg\" \"nodes/**/*.png\" dist/",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "jest": "^29.7.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}